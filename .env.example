# korea-realestate-tax-engine — API 키 (선택)
# 키가 없어도 세금 판정·계산 도구는 전부 동작합니다.
# 법령 원문·해석례·재결례 조회(search_law, get_law_detail, get_local_tax_ordinances, search_tax_rulings)와
# 검증용 재결례 재수집(scripts/fetch_rulings.py)에만 아래 무료 키가 필요합니다.

# 법제처 국가법령정보 Open API (open.law.go.kr) — 가입 이메일의 아이디 부분
LAW_OC=

# 부동산 기초정보 조회(lookup_pnu, lookup_official_price, lookup_redev_zone) — 선택
# 도로명주소 개발자센터(business.juso.go.kr) 검색 API 승인키 — 지번주소 → PNU 변환
JUSO_API_KEY=
# 브이월드 오픈API(vworld.kr) 인증키 — 공시가격·토지특성(용도지역)·정비구역 조회
VWORLD_API_KEY=
# 브이월드 키 발급 때 등록한 서비스 URL(도메인). 비워 두면 빈 값으로 보낸다
VWORLD_DOMAIN=
